# Environment Variables - Vietnamese VQA Distillation
# Copy this to .env and fill in your values

# HuggingFace settings
HF_HUB_CONNECT_TIMEOUT=60
HF_HUB_READ_TIMEOUT=60
HF_HUB_ETAG_TIMEOUT=60
HF_HUB_DISABLE_TELEMETRY=1
# Public demo resources do not require authentication. Set this only when
# accessing a private Hub resource or pushing a new model.
HF_TOKEN=

# CUDA/GPU settings
CUDA_VISIBLE_DEVICES=0
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# Weights & Biases (optional)
# WANDB_PROJECT=vietnamese-vqa-distillation
# WANDB_ENTITY=your_wandb_username
# WANDB_API_KEY=your_wandb_api_key

# Logging
LOG_LEVEL=INFO
DEBUG=False
